flowchart TD
    A[Individual] --> I_UB{Unary \nor \nbinary?}

    %% UNARY INDIVIDUALS
    I_UB -->|Unary| I0{Endurant/\nperdurant/\nor situation?}

    I0 -->|Endurant| IE{Substantial \nor \nmoment?}
    I0 -->|Perdurant| IP[Event/\nactivity/\nprocess\nindividual]
    I0 -->|Situation| ISIT[Situation\nindividual]

    IE -->|Substantial| IES[Substantial\nindividual]
    IE -->|Moment| IIM[Moment\nindividual]

    %% BINARY INDIVIDUALS (RELATIONS/ASSOCIATIONS)
    I_UB -->|Binary| ROA{"Relation \nor association?"}

    ROA --> DOPR{"Domain \nor part-whole \nrelation?"}
    ROA --> FA["Fundamental \nAssociation"]

    %% DOMAIN RELATIONS - INDIVIDUAL LEVEL
    DOPR --> DR{Depends on \nintrinsic properties?}
    DR -->|Yes| FORI[Formal \nrelation\nindividual]
    DR -->|No| MATI[Material \nrelation\nindividual]

    %% PART-WHOLE RELATIONS - INDIVIDUAL LEVEL
    DOPR --> PWI[Part-whole \nindividual]

    %% FUNDAMENTAL ASSOCIATIONS - INDIVIDUAL LEVEL
    FA --> FA1{What does it \nconnect?}
    FA1 -->|Moment to bearer| INHER[Inherence\nindividual]
    FA1 -->|Relator to entities| MEDI[Mediation\nindividual]
    FA1 -->|Quality to value\nin quality structure| STRU[Structuration]
    FA1 -->|Event to participants| PARTI[Participation\nindividual]

    %% EXAMPLES
    IES_ex("e.g., John,\nMary,\nthis apple"):::example
    IES --> IES_ex

    IIM_ex("e.g., John's height,\nthis apple's color"):::example
    IIM --> IIM_ex

    IP_ex("e.g., this meeting,\nflight AA123,\nJohn's surgery"):::example
    IP --> IP_ex

    ISIT_ex("e.g., John having fever,\nthe meeting being scheduled"):::example
    ISIT --> ISIT_ex

    FORI_ex("e.g., John isTallerThan Mary,\nthis apple individualOf Apple"):::example
    FORI --> FORI_ex

    MATI_ex("e.g., John isMarriedTo Mary,\nJohn worksFor CompanyX"):::example
    MATI --> MATI_ex

    INHER_ex("e.g., John's height \ninheres in John"):::example
    INHER --> INHER_ex

    MEDI_ex("e.g., Marriage #123 \nmediates John and Mary"):::example
    MEDI --> MEDI_ex

    STRU_ex("e.g., John's height \\nstructured by 180cm, \\nthis apple's color \\nstructured by 'red'"):::example
    STRU --> STRU_ex

    PARTI_ex("e.g., John participates \nin this meeting"):::example
    PARTI --> PARTI_ex

    PWI_ex("e.g., this engine componentOf this car, \nJohn memberOf this team, \nthis wine subQuantityOf this bottle"):::example
    PWI --> PWI_ex

    %% CLASSES
    classDef example fill:#BBBBBB,stroke:#111827,stroke-width:1px,color:#fff;
    classDef generic fill:#ffffff,stroke:#333,stroke-width:2px,color:#000;
    classDef perdurant fill:#aaaaaa,stroke:#2563eb,stroke-width:2px,color:#000;
    classDef substantial fill:#aaaaaa,stroke:#16a34a,stroke-width:2px,color:#000;
    classDef intrinsic fill:#aaaaaa,stroke:#fb923c,stroke-width:2px,color:#000;
    classDef relator fill:#aaaaaa,stroke:#ea580c,stroke-width:2px,color:#000;
    classDef meronymic fill:#aaaaaa,stroke:#eab308,stroke-width:2px,color:#000;
    classDef fundamental fill:#aaaaaa,stroke:#a855f7,stroke-width:2px,color:#000;
    classDef situation fill:#aaaaaa,stroke:#9333ea,stroke-width:2px,color:#000;

    %% Apply styles
    class I_UB,I0,IE,ROA,DOPR,DR,PWI,FA1 generic;
    class IP perdurant;
    class IES substantial;
    class IIM intrinsic;
    class FORI,MATI relator;
    class PWI meronymic;
    class FA,INHER,MEDI,PARTI,STRU fundamental;
    class ISIT situation;