flowchart TD
    M0[Moment type]

    M0 --> M1{Intrinsic \nor \nRelator?}
    M1 -->|Intrinsic| IM[Intrinsic \nmoment \ntype]
    M1 -->|Relator| RL[Relator \ntype]

    IM --> Q0{Quality \nor \nmode?}
    Q0 -->|Quality| QL[Quality \ntype]
    Q0 -->|Mode| MD[Mode / \nDisposition type]

    %% Simple clarification of mode kinds (no extra diamonds)
    MD --> MDN((Mode as \nway-of-being))
    MD --> MDV((Mode with \nparameters))

    %% First, classify quality kind
    QL --> Q2{Perceivable/\nnon-perceivable/\nnominal?}
    Q2 -->|Perceivable| QP[Perceivable \nquality type]
    Q2 -->|Non-perceivable| QN[Non-perceivable \nquality type]
    Q2 -->|Nominal| QNOM[Nominal \nquality type]

    %% Then, choose how this quality is measured (value space)
    QL --> VS((Choose \nvalue space))
    VS_ex("e.g., datatype for numeric values,\nenumeration for named categories"):::example
    VS --> VS_ex

    %% Nominal qualities usually use enumerations / lexical spaces
    VSN_ex("e.g., status enumeration,\nname strings, ISBN"):::example
    QNOM --> VSN_ex

    %% Relator + MATERIAL RELATIONS
    RL --> RM{Can it derive \na \nmaterial relation?}
    RM -->|Yes| MRD[Derived \nmaterial relation]
    RM -->|No| RLE[Relator only]

    %% EXAMPLE BOXES + LINKS

    %% Unary types – moments
    MD_ex("e.g., Fragility, Skill"):::example
    MD --> MD_ex

    %% EXAMPLES FOR QUALITY TYPES
    QP_ex([e.g., color, weight]):::example
    QP --> QP_ex

    QN_ex([e.g., bank balance,\ninterest rate]):::example
    QN --> QN_ex

    MDN_ex("e.g., being fragile,\nbeing obliged"):::example
    MDN --> MDN_ex
    MDV_ex("e.g., obligation with\namount & due date"):::example
    MDV --> MDV_ex

    %% Derived material relation (explicitly from relator)
    MRD_ex["e.g., isMarriedTo\nderived from Marriage"]:::example
    MRD --> MRD_ex

    %% Relator only (you don't model isMarriedTo separately)
    RLE_ex["e.g., Marriage used\nwithout isMarriedTo"]:::example
    RLE --> RLE_ex

    %% CLASSES
    classDef example fill:#BBBBBB,stroke:#111827,stroke-width:1px,color:#ffffff,font-size:10px;
    classDef generic fill:#ffffff,stroke:#333,stroke-width:2px,color:#000;
    classDef intrinsic fill:#ffedd5,stroke:#fb923c,stroke-width:2px,color:#000;
    classDef relator fill:#fdba74,stroke:#ea580c,stroke-width:2px,color:#000;

    %% generic / neutral nodes
    class M1,Q0,Q2,RM,VS,MDN,MDV generic;

    %% subtree colors
    class M0,IM,QL,MD,QP,QN,QNOM intrinsic;
    class RL,MRD,RLE relator;
