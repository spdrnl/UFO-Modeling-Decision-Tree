flowchart TD
    A[Individual] --> I_UB{Unary \nor \nbinary?}

    %% UNARY INDIVIDUALS
    I_UB -->|Unary| I_COA{Concrete or \nabstract?}

    %% ABSTRACT INDIVIDUALS
    I_COA -->|Abstract| I_ABS["Abstract \nindividual \n(Value)"]
    I_ABS_ex("e.g., $10.00, \nMonday, \nthe hex code #FF0000"):::example
    I_ABS --> I_ABS_ex

    %% CONCRETE INDIVIDUALS
    I_COA -->|Concrete| I0{Endurant/\nperdurant/\nor situation?}

    I0 -->|Endurant| IE{Substantial \nor \nmoment?}
    I0 -->|Perdurant| IP[Event/\nactivity/\nprocess\nindividual]
    I0 -->|Situation| ISIT[Situation\nindividual]

    IE -->|Substantial| IES[Substantial\nindividual]
    IE -->|Moment| IIM[Moment\nindividual]

    %% BINARY INDIVIDUALS (RELATIONS/ASSOCIATIONS)
    I_UB -->|Binary| ROA{"Relation \nor association?"}

    ROA --> DOPR{"Domain \nor part-whole \nrelation?"}
    ROA --> FA["Fundamental \nassociation \nindividual"]

    %% DOMAIN RELATIONS - INDIVIDUAL LEVEL
    DOPR --> DR{Depends on \nintrinsic properties?}
    DR -->|Yes| FORI[Formal \nrelation\nindividual]
    DR -->|No| MATI[Material \nrelation\nindividual]

    %% PART-WHOLE RELATIONS - INDIVIDUAL LEVEL
    DOPR --> PWI[Part-whole \nindividual]


    %% EXAMPLES
    IES_ex("e.g., John, Mary, \nSunrise Breakfast Place"):::example
    IES --> IES_ex

    IIM_ex("e.g., Mary's patience, \nJohn's cooking skill"):::example
    IIM --> IIM_ex

    IP_ex("e.g., today's breakfast service, \nJohn and Mary's wedding, \na specific payment"):::example
    IP --> IP_ex

    ISIT_ex("e.g., Sunrise being understaffed, \nJohn being married to Mary"):::example
    ISIT --> ISIT_ex

    FORI_ex("e.g., John isOlderThan Mary, \ntable 4 isNextTo table 5"):::example
    FORI --> FORI_ex

    MATI_ex("e.g., John isMarriedTo Mary, \nMary worksFor Sunrise"):::example
    MATI --> MATI_ex

    FA_ex("e.g., Mary's patience inheres in Mary, \nMary's height structured by 168cm, \nJohn participates in this breakfast service"):::example
    FA --> FA_ex

    PWI_ex("e.g., this grill componentOf this kitchen, \nJohn memberOf the staff team, \nthis milk subQuantityOf this carton"):::example
    PWI --> PWI_ex

    %% CLASSES
    classDef example fill:#BBBBBB,stroke:#111827,stroke-width:1px,color:#fff;
    classDef generic fill:#ffffff,stroke:#333,stroke-width:2px,color:#000;
    classDef perdurant fill:#aaaaaa,stroke:#2563eb,stroke-width:2px,color:#000;
    classDef substantial fill:#aaaaaa,stroke:#16a34a,stroke-width:2px,color:#000;
    classDef intrinsic fill:#aaaaaa,stroke:#fb923c,stroke-width:2px,color:#000;
    classDef relator fill:#aaaaaa,stroke:#ea580c,stroke-width:2px,color:#000;
    classDef meronymic fill:#aaaaaa,stroke:#eab308,stroke-width:2px,color:#000;
    classDef fundamental fill:#aaaaaa,stroke:#a855f7,stroke-width:2px,color:#000;
    classDef abstract fill:#f3f4f6,stroke:#9ca3af,stroke-width:2px,color:#000;
    classDef situation fill:#aaaaaa,stroke:#9333ea,stroke-width:2px,color:#000;

    %% Apply styles
    class I_UB,I_COA,I0,IE,ROA,DOPR,DR,PWI,FA1 generic;
    class IP perdurant;
    class IES substantial;
    class I_ABS abstract;
    class IIM intrinsic;
    class FORI,MATI relator;
    class PWI meronymic;
    class FA,INHER,MEDI,PARTI,STRU fundamental;
    class ISIT situation;