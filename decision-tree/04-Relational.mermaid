flowchart TD
    RT["Relational term"] --> R0{"Relation \nor association?"}
    R1{"Domain \nor part-whole \nrelation?"}

    %% MAIN CATEGORIES
    R0 --> R1
    R1 --> DR[Domain \nrelation]
    R1 --> PW[Part-whole \nrelation]
    R0 --> FA[Fundamental \nassociation]

    %% DOMAIN RELATIONS
    DR --> DR1{Relation depends \non intrinsic \nproperties only?}
    DR1 -->|Yes| FOR[Formal \nrelation]
    DR1 -->|No| MAT{Relator \nor derived \nmaterial relation?}

    MAT --> RL[Relator \ntype]
    RL_ex("e.g., Marriage, \nEmployment, \nSupplyContract"):::example
    RL --> RL_ex
    MAT --> MR[Material \nrelation]

    MR -.->|Derivation| RL

    %% FUNDAMENTAL ASSOCIATIONS
    FA --> FA1{What does it \nconnect?}
    FA1 -->|Bearer to moment| CHAR[Characterization]
    FA1 -->|Relator to entities| MED[Mediation]
    FA1 -->|Material relation to relator| DER[Derivation]
    FA1 -->|Quality to quality structure| STRU[Structuration]
    FA1 -->|Object to event| PART[Participation]
    FA1 -->|Event to object| CRETERM["Creation / \nTermination"]
    FA1 -->|Event to mode| MAN[Manifestation]
    FA1 -->|Event to situation| BA[BringsAbout]
    FA1 -->|Situation to event| TRIG[Triggers]

    %% PART-WHOLE
    PW --> PW1{What type \nof whole?}

    PW1 -->|Functional complex| CPO[ComponentOf]
    PW1 -->|Collective| MBO[MemberOf]
    PW1 -->|Collection| SCO[SubCollectionOf]
    PW1 -->|Quantity| SQO[SubQuantityOf]
    PW1 -->|Non-standard| CON["Containment\n(spatial)"]

    %% EXAMPLES - Formal Relations
    FOR_ex("e.g., John isOlderThan Mary, \nSunrise isCloserTo Market"):::example
    FOR --> FOR_ex

    MR_ex("e.g., isMarriedTo, \nworksFor Sunrise, \nsuppliesTo Sunrise"):::example
    MR --> MR_ex

    %% EXAMPLES - Fundamental Associations
    CHAR_ex("e.g., Mary \ncharacterizedBy Patience, \nCafe characterizedBy Rating"):::example
    CHAR --> CHAR_ex

    MED_ex("e.g., Marriage \nmediates Person, \nEmployment mediates Cook and Sunrise"):::example
    MED --> MED_ex

    DER_ex("e.g., isMarriedTo \nderives from Marriage, \nworksFor derives from Employment"):::example
    DER --> DER_ex

    STRU_ex("e.g., CoffeeTemperature \nstructuredBy TemperatureValue, \nHygieneRating structuredBy RatingValue"):::example
    STRU --> STRU_ex

    PART_ex("e.g., Cook participatesIn BreakfastService, \nCustomer participatesIn PaymentEvent"):::example
    PART --> PART_ex

    CRETERM_ex("e.g., PancakePreparation \ncreates Meal, \nBreakfastService terminates ServiceFinished"):::example
    CRETERM --> CRETERM_ex

    MAN_ex("e.g., PancakePreparation \nmanifests CookingSkill"):::example
    MAN --> MAN_ex

    BA_ex("e.g., PlacingOrder \nbringsAbout OrderPlaced"):::example
    BA --> BA_ex

    TRIG_ex("e.g., OrderPlaced \ntriggers PancakePreparation"):::example
    TRIG --> TRIG_ex

    %% EXAMPLES - Part-Whole
    CPO_ex("e.g., Grill \ncomponentOf Kitchen, \nKitchen componentOf Cafe"):::example
    CPO --> CPO_ex

    MBO_ex("e.g., Staff \nmemberOf StaffTeam, \nOwner memberOf OwnersAssoc"):::example
    MBO --> MBO_ex

    SCO_ex("e.g., WeekendStaff \nsubCollectionOf \nFull Staff Team"):::example
    SCO --> SCO_ex

    SQO_ex("e.g., Milk \nsubQuantityOf Milk Stock, \nButter subQuantityOf Butter Block"):::example
    SQO --> SQO_ex

    CON_ex("e.g., Croissant \nin Display Case, \nEggs in Refrigerator"):::example
    CON --> CON_ex

    %% CLASSES
    classDef example fill:#BBBBBB,stroke:#111827,stroke-width:1px,color:#ffffff;
    classDef generic fill:#ffffff,stroke:#333,stroke-width:2px,color:#000;
    classDef relator fill:#fdba74,stroke:#ea580c,stroke-width:2px,color:#000;
    classDef meronymic fill:#fef08a,stroke:#eab308,stroke-width:2px,color:#000;
    classDef fundamental fill:#e9d5ff,stroke:#a855f7,stroke-width:2px,color:#000;

    %% Apply styles
    class R0,R1,DR1,PW1,MAT,FA1 generic;
    class DR,FOR,MR,RL relator;
    class PW,CPO,MBO,SCO,SQO,CON meronymic;
    class FA,CHAR,MED,DER,PART,STRU,CRETERM,MAN,BA,TRIG fundamental;
