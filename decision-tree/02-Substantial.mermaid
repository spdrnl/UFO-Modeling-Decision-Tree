flowchart TD
    S0[Substantial type]

    S0 --> S_CA{Concrete or \nAbstract?}

    %% ABSTRACT SUBSTANTIALS
    S_CA -->|Abstract| ABST[Abstract Type]
    ABST --> ABST_Q{Fixed value \nspace?}
    ABST_Q -->|Yes| ENUM[Enumeration]
    ABST_Q -->|No| DT[Datatype]

    %% CONCRETE SUBSTANTIALS
    S_CA -->|Concrete| SS{"Sortal?\n(identity providing)"}

    SS -->|Yes| S1{"Rigid?\n(non-changeable)"}
    SS -->|No| M_X{"Rigid,\nsemi-rigid,\nnon-rigid?\n(changeability)"}

    %% Sortals
    S1 -->|Yes| RG{Ultimate \nsortal \nor \nsubkind?}
    S1 -->|No| DR{Relationally\ndependent?}

    RG -->|Subkind| SK[Subkind]
    RG -->|Ultimate sortal| US{Object/\ncollective/\nquantity?}
    US -->|Object| KND[Kind]
    US -->|Collective| COL[Collective]
    US -->|Quantity| QTY["Quantity\n(portion)"]

    DR -->|Yes| RO[Role]
    DR -->|No| PH[Phase]

    %% Non-Sortals (Mixins)
    M_X -->|Rigid| CAT[Category]
    M_X -->|Semi-rigid| MIX[Semi-Rigid Mixin]
    M_X -->|Non-rigid| M_DX{Relationally\ndependent?}

    M_DX -->|Yes| RMX[RoleMixin]
    M_DX -->|No| PMX[PhaseMixin]

    %% EXAMPLE BOXES + LINKS
    DT_ex("e.g., CurrencyAmount, \nTemperatureValue, \nRatingValue"):::example
    DT --> DT_ex

    ENUM_ex("e.g., DayOfWeek(Mon, Tue...), \nTableState(Clean, Dirty)"):::example
    ENUM --> ENUM_ex

    KND_ex("e.g., Person, BreakfastPlace, \nSupplierCompany"):::example
    KND --> KND_ex

    SK_ex("e.g., ArabicaCoffeeBeanBatch, \nFamilyRunBreakfastPlace"):::example
    SK --> SK_ex

    COL_ex("e.g., StaffTeam, \nSupplierConsortium"):::example
    COL --> COL_ex

    QTY_ex("e.g., Coffee, Milk, Batter"):::example
    QTY --> QTY_ex

    CAT_ex("e.g., PhysicalObject, \nCommercialEstablishment"):::example
    CAT --> CAT_ex

    MIX_ex("e.g., SkilledWorker, \nInsuredAsset"):::example
    MIX --> MIX_ex

    RMX_ex("e.g., ServiceProvider, FoodBuyer"):::example
    RMX --> RMX_ex

    PMX_ex("e.g., AvailableResource, \nHeatedConsumable"):::example
    PMX --> PMX_ex

    RO_ex("e.g., Cook, Customer, \nEmployee, Employer"):::example
    RO --> RO_ex

    PH_ex("e.g., Child, Adult"):::example
    PH --> PH_ex

    %% CLASSES
    classDef example fill:#BBBBBB,stroke:#111827,stroke-width:1px,color:#ffffff;
    classDef generic fill:#ffffff,stroke:#333,stroke-width:2px,color:#000;
    classDef substantial fill:#dcfce7,stroke:#dcfce7,stroke-width:2px,color:#000;
    classDef substantialId fill:#dcfce7,stroke:#16a34a,stroke-width:2px,color:#000;
    classDef substantialNonId fill:#dcfce7,stroke:#16a34a,stroke-width:2px,stroke-dasharray: 5 3,color:#000;
    classDef abstract fill:#f3f4f6,stroke:#9ca3af,stroke-width:2px,color:#000;

    %% generic / neutral nodes
    class S_CA,ABST_Q,SS,S1,M_X,RG,US,DR,M_SR,M_DX generic;

    %% substantial subtree colors
    class KND,COL,QTY substantialId;
    class SK,RO,PH substantialNonId;
    class S0,CAT,RMX,PMX,MIX substantial;
    class ABST,DT,ENUM abstract;