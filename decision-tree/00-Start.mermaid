flowchart TD
    A[Start term] --> B{Individual \nor \nuniversal?}

    %% INDIVIDUALS
    B -->|Individual| I[Individual]

    %% UNIVERSALS (TYPES)
    B -->|Universal| T0{Unary or \nbinary type?}

    %% TYPES – UNARY (CONCEPTS)
    T0 -->|Unary| U0{1st-order \nor \nhigher?}
    T0 -->|Binary| R0{"Relation\nor\nassociation?"}

    R0 --> TR1{"Domain \nor part-whole \nrelation?"}
    TR1 --> TDR[Domain \nrelation]
    TR1 --> TPW[Part-Whole \nrelation]
    R0 --> TFA[Fundamental \nassociation]

    TDR --> TDR_ex("e.g., isMarriedTo, \nworksFor Sunrise"):::example
    TPW --> TPW_ex("e.g., Griddle componentOf Kitchen, \nStaff memberOf StaffTeam"):::example
    TFA --> TFA_ex("e.g., Mary characterizedBy Patience, \nMarriage mediates Person"):::example

    U0 -->|Higher| UH[Higher-order \ntype]
    U0 -->|1st-order| U1{Concrete or \nabstract concept?}

    %% ABSTRACT TYPES
    U1 -->|Abstract| ABST[Abstract Type]
    ABST_ex("e.g., CurrencyAmount, \nDayOfWeek"):::example
    ABST --> ABST_ex

    %% CONCRETE TYPES
    U1 -->|Concrete| C0{Endurant \nor \nperdurant?}

    C0 --> E0[Endurant \ntype]
    C0 --> P0[Perdurant \ntype]

    E0 --> E1{Independent?}
    E1 -->|Yes| S0[Substantial \ntype]
    E1 -->|No| M0[Moment \ntype]

    %% EXAMPLES
    P0_ex("e.g., BreakfastService,\nWeddingCeremony"):::example
    P0 --> P0_ex

    S0_ex("e.g., Person,\nBreakfastPlace,\nCoffee"):::example
    S0 --> S0_ex

    M0_ex("e.g., JohnsCookingSkill,\nMarriage,\nHygieneRating"):::example
    M0 --> M0_ex

    %% CLASSES
    classDef example fill:#BBBBBB,stroke:#111827,stroke-width:1px,color:#fff;
    classDef generic fill:#ffffff,stroke:#333,stroke-width:2px,color:#000;
    classDef perdurant fill:#dbeafe,stroke:#2563eb,stroke-width:2px,color:#000;
    classDef substantial fill:#dcfce7,stroke:#dcfce7,stroke-width:2px,color:#000;
    classDef intrinsic fill:#ffedd5,stroke:#fb923c,stroke-width:2px,color:#000;
    classDef relator fill:#fdba74,stroke:#ea580c,stroke-width:2px,color:#000;
    classDef meronymic fill:#fef08a,stroke:#eab308,stroke-width:2px,color:#000;
    classDef fundamental fill:#e9d5ff,stroke:#a855f7,stroke-width:2px,color:#000;
    classDef abstract fill:#f3f4f6,stroke:#9ca3af,stroke-width:2px,color:#000;

    %% universal branch class assignments
    class TFA fundamental;
    class TPW meronymic;
    class TDR relator;

    %% generic / neutral nodes
    class A,B,T0,U0,U1,UH,E0,E1,R0,TR1,C0 generic;
    class I generic;

    %% leaf colors
    class P0 perdurant;
    class S0 substantial;
    class M0 intrinsic;
    class ABST abstract;