flowchart TD
    R0{"Domain or\npart-whole\nrelation?"}

    %% MAIN CATEGORIES
    R0 --> DR[Domain \nRelations]
    R0 --> PW[Part-Whole \nRelations]

    %% DOMAIN RELATIONS
    DR --> DR1{Does it depend \non intrinsic \nproperties only?}
    DR1 -->|Yes| FOR[Formal \nrelation]
    DR1 -->|No| MAT{Model as \nrelator or \n derived relation?}

    MAT -->|Relator| RL[Relator \ntype]
    RL_ex("e.g., Marriage, \nEmployment, \nEnrollment"):::example
    RL --> RL_ex
    MAT -->|Derived relation| MR[Material \nrelation]

    RL -.->|can derive| MR

    %% PART-WHOLE
    PW --> PW1{What type \nof whole?}

    PW1 -->|Functional complex| CPO[ComponentOf]
    PW1 -->|Collective| MBO[MemberOf]
    PW1 -->|Collection| SCO[SubCollectionOf]
    PW1 -->|Quantity| SQO[SubQuantityOf]

    %% EXAMPLES - Formal Relations
    FOR_ex("e.g., isTallerThan, \nisBetween"):::example
    FOR --> FOR_ex

    MR_ex("e.g., isMarriedTo, \nworksFor, \nisEnrolledIn"):::example
    MR --> MR_ex

    %% EXAMPLES - Part-Whole
    CPO_ex("e.g., Engine \ncomponentOf Car, \nHeart componentOf Body"):::example
    CPO --> CPO_ex

    MBO_ex("e.g., Tree \nmemberOf Forest, \nPlayer memberOf Team"):::example
    MBO --> MBO_ex

    SCO_ex("e.g., Deck \nsubCollectionOf \nCard Collection"):::example
    SCO --> SCO_ex

    SQO_ex("e.g., Alcohol \nsubQuantityOf Wine, \nWater subQuantityOf Ocean"):::example
    SQO --> SQO_ex

    %% CLASSES
    classDef example fill:#BBBBBB,stroke:#111827,stroke-width:1px,color:#ffffff,font-size:10px;
    classDef generic fill:#ffffff,stroke:#333,stroke-width:2px,color:#000;
    classDef relator fill:#fdba74,stroke:#ea580c,stroke-width:2px,color:#000;
    classDef meronymic fill:#fef08a,stroke:#eab308,stroke-width:2px,color:#000;
    classDef note fill:#dbeafe,stroke:#2563eb,stroke-width:1px,stroke-dasharray: 3 3,color:#000,font-size:9px;

    %% Apply styles
    class R0,DR1,PW1,MAT generic;
    class DR,FOR,MR,RL relator;
    class PW,CPO,MBO,SCO,SQO meronymic;
    class NOTE1,NOTE2,NOTE3,NOTE4,NOTE5 note;