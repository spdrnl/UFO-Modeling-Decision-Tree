package OtherHigherOrderTypes

// Category: Other higher-order types
// These categorize other types but are not necessarily powertypes
type Species
type Breed
type ProductCategory
type EstablishmentCategory // e.g., "Restaurant", "Cafe", "Retail"

// Examples of instances (types) for the higher-order types
// BreakfastPlace (a type) is an instance of EstablishmentCategory
// GoldenRetriever (a type) is an instance of Breed
