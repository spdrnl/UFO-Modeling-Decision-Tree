package NonSortals

// Category: Category (Rigid Non-Sortal)
// 'Cutlery' contains items like knife, fork, spoon.
category Cutlery

// Category: Mixin (Semi-rigid Non-Sortal)
// 'SkilledWorker' can be specialized by kinds such as Person or by roles like Cook
mixin SkilledWorker

// Category: RoleMixin (Anti-rigid Relational Non-Sortal)
// 'ServiceProvider' can be played by Person or BreakfastPlace
roleMixin ServiceProvider

// Category: PhaseMixin (Anti-rigid Intrinsic Non-Sortal)
// 'AvailableResource' can classify things like Coffee or Grill when they are available
phaseMixin AvailableResource
