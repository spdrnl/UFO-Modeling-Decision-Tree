package BinaryIndividuals

// Category: Formal relation at the individual level
// Example: John is older than Mary (both are instances of Person)
kind Person
// Formal relations are often modeled as associations with the «formal» stereotype
@formal
relation Person [1] -- isOlderThan -- [1] Person

// Category: Material relation at the individual level
// Example: John isMarriedTo Mary (their relation is grounded in an instance of Marriage)
// Material relations are derived from relators.
relator Marriage

@mediation
relation Marriage [1] -- mediatesSpouse1 -- [1] Person

@mediation
relation Marriage [1] -- mediatesSpouse2 -- [1] Person


@material
relation Person [0..1] -- isMarriedTo -- [0..1] Person
@derivation
relation Person.isMarriedTo [1] -- derivedFrom -- [1] Marriage

// Category: Fundamental associations at the individual level
// Example: Mary's patience inheresIn Mary (Patience depends on a Person bearer)
quality Patience
// 'inheresIn' is a fundamental association
@characterization
relation Patience [1] -- inheresIn -- [1] Person

// Category: Part-whole at the individual level
// Example: this Grill componentOf this Kitchen in Sunrise Breakfast Place
kind Grill
kind Kitchen
// 'componentOf' is a part-whole relation
@componentOf
relation Kitchen [1] <>-- hasGrill -- [0..*] Grill
