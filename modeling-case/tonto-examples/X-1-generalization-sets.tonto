package GeneralizationSets

kind Person
powertype BusinessCategorizer
category BusinessEntity
kind BreakfastPlace
kind SupplierCompany
subkind FamilyRunBreakfastPlace specializes BreakfastPlace
subkind MarketSupplier specializes SupplierCompany

// 1. Generalization Sets & Constraints
// Grouping specializations and defining if they are disjoint or complete
phase Adult specializes Person
phase Child specializes Person

disjoint complete genset PersonLifeStage {
    general Person
    specifics Adult, Child
}

complete genset BusinessKinds {
    general BusinessEntity
    categorizer BusinessCategorizer
    specifics FamilyRunBreakfastPlace, MarketSupplier
}

disjoint complete genset PersonLifeStageShort where Child, Adult specializes Person
