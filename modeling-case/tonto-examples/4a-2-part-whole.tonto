package PartWhole

// These examples correspond to 04a-Relation.mermaid (Part-whole relations)

// Core types
kind Grill
kind Kitchen
kind StaffMember
collective Staff
collective StaffTeam
quantity Milk
quantity Butter
kind DisplayCase
kind Refrigerator
kind Croissant
kind EggCarton
kind Sink

// Category: ComponentOf (Functional complex)
// Example: Grill componentOf Kitchen, Kitchen componentOf BreakfastPlace
@componentOf
relation Kitchen [1] <>-- hasGrill -- [0..*] Grill

// Every Kitchen has at least one Sink as a component
@componentOf
relation Kitchen [1] <>-- hasSink -- [1..*] Sink

// or use an inline declaration
//
// kind Kitchen {
//     // A Kitchen contains at least one Sink
//     @componentOf
//     [1] <>-- sinks -- [1..*] Sink
// }


// Category: MemberOf (Collective)
// Example: StaffMember memberOf StaffTeam
@memberOf
relation StaffTeam [1] <>-- hasMember -- [0..*] StaffMember

// Category: SubCollectionOf (Collection)
// Example: WeekendStaff subCollectionOf FullStaffTeam
// 'WeekendStaff' and 'FullStaffTeam' are collections built from StaffMember members
collective WeekendStaff {
    @memberOf
    [1] <>-- members -- [6..6] StaffMember
}

collective FullStaffTeam

// WeekendStaff is still a subset of the FullStaffTeam
@subCollectionOf
relation FullStaffTeam [1] <>-- hasSubTeam -- [0..*] WeekendStaff

// Category: SubQuantityOf (Quantity)
// Example: Butter subQuantityOf ButterBlock
quantity ButterBlock

@subQuantityOf
relation ButterBlock [1] <>-- hasSubQuantity -- [0..*] Butter

// Category: Containment (Non-standard, spatial)
// Example: Croissant in DisplayCase, Eggs in Refrigerator
// `containment` is a custom stereotype here, not a UFO part-whole stereotype.

@containment
relation DisplayCase [1] <>-- contains -- [0..*] Croissant

@containment
relation Refrigerator [1] <>-- contains -- [0..*] EggCarton
