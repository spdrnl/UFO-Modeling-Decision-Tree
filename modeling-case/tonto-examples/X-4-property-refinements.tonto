import PartWhole

package PropertyRefinements

// 4. Property Refinements
// Subsets and redefines
kind Kitchen
kind Sink
kind IndustrialSink specializes Sink

@componentOf
relation Kitchen [1] -- hasSink -- [1..*] (sinks) Sink

@componentOf
relation Kitchen [1] -- hasIndustrialSink -- [1..*] ({ subsets Kitchen.hasSink.sinks } industrialSinks) IndustrialSink
