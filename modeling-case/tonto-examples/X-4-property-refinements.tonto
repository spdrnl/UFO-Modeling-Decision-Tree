import PartWhole

package PropertyRefinements

// 4. Property Refinements
// Subsets and redefines
kind Kitchen
kind Sink
kind IndustrialSink specializes Sink

@componentOf
relation Kitchen [1] -- hasSink -- [1..*] (sinks) Sink

// `subsets` should point to the refined relation end. The exact qualified
// relation-end reference should be confirmed once Tonto validation is working.
@componentOf
relation Kitchen [1] -- hasIndustrialSink -- [1..*] (industrialSinks) IndustrialSink
