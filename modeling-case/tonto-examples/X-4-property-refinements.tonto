import PartWhole

package PropertyRefinements

// 4. Property Refinements
// Subsets and redefines
kind Kitchen
kind Sink
subkind IndustrialSink specializes Sink

@componentOf
relation Kitchen [1] -- hasSink -- [1..*] (sinks) Sink

@componentOf
relation Kitchen ({ const } kitchen) [1] -- hasIndustrialSink -- [1..*] ({ ordered, derived, subsets Kitchen.hasSink.sinks } industrialSinks) IndustrialSink

@componentOf
relation Kitchen [1] -- hasReplacementSink -- [0..1] ({ redefines Kitchen.hasSink.sinks } replacementSink) Sink
