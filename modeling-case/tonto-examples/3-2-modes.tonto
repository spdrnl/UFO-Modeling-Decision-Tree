package Modes

kind Person
datatype CurrencyAmount

// Category: Mode as a way of being
mode CurrentIntention

@characterization
relation CurrentIntention [1] -- inheresIn -- [1] Person

// Category: Disposition as a manifestable intrinsic mode
intrinsicMode CookingSkill

@characterization
relation CookingSkill [1] -- inheresIn -- [1] Person

// Category: Mode with internal structure or parameters
mode RentObligation {
    dueDate: Date
    amount: CurrencyAmount
}

@characterization
relation RentObligation [1] -- inheresIn -- [1] Person
