package AbstractTypes

// These examples correspond to 02b-Abstract.mermaid

// Category: Datatype
// Used as value space for qualities such as BankBalance
datatype Decimal
datatype String
datatype CurrencyAmount {
    amount: Decimal [1]
    currency: String [1]
}

// Category: Enumeration
// Used as value space for nominal qualities such as TableCleanliness
enum TableState {
    Clean, Dirty
}
