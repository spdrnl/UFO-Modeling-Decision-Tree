package Powertypes

// Base types needed for powertypes
kind Person
kind BreakfastPlace
mode Mode
relator Relator
event Event
event Activity

// Category: Substantial powertypes
// PersonType is a powertype of Person (instances are types like Cook, Customer)
powertype PersonType

// EstablishmentType is a powertype of BreakfastPlace
powertype EstablishmentType

// Category: Moment powertypes
// SkillType is a powertype of Mode (instances are types like CookingSkill)
powertype SkillType

// Category: AgreementType is a powertype of Relator (instances are types like Marriage)
powertype AgreementType

// Category: Perdurant powertypes
// EventType is a powertype of Event
powertype EventType

// Category: ServiceType is a powertype of Activity (instances are types like BreakfastService)
powertype ServiceType
