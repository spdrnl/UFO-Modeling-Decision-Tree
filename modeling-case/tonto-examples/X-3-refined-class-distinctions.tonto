package RefinedClassDistinctions

kind Person
kind Organization
historicalRoleMixin FormerParticipant
intrinsicMode Patience
event Retirement

// 3. Refined Class Distinctions
// Historical roles and extrinsic modes
historicalRole DeceasedPerson specializes Person

kind Bank
extrinsicMode Debt
@characterization
relation Debt [1] -- inheresIn -- [1] Person
@externalDependence
relation Debt [1] -- dependsOn -- [1] Bank
@inherence
relation Patience [1] -- inheresIn -- [1] Person
@historicalDependence
relation FormerParticipant [0..*] -- historicallyDependsOn -- [1] Organization
@historicalDependence
relation DeceasedPerson [0..*] -- resultedFrom -- [1] Retirement
